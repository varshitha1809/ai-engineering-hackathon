# PHISHDNA AI configuration — copy to .env and edit. Never commit .env.

# Optional API key. When set, every /api/v1 request must send header X-API-Key.
# The frontend reads VITE_API_KEY (frontend/.env.local) to send it.
PHISHDNA_API_KEY=

# SQLite database location (relative to backend/)
PHISHDNA_DB_PATH=phishdna.db

# Model artifact directory (relative to repo root)
PHISHDNA_MODEL_DIR=models

# Requests per minute per client for analyze endpoints
PHISHDNA_RATE_LIMIT_PER_MIN=120

# Max upload size in bytes (default 5 MB)
PHISHDNA_MAX_EMAIL_BYTES=5242880

# Retain raw submitted email content (needed for re-score). Set false to keep only evidence excerpts.
PHISHDNA_RETAIN_RAW=true

# Organisation domains (comma separated) - used for impersonation / lookalike checks
PHISHDNA_ORG_DOMAINS=phishdna-demo.local

# Authentication-Results authserv-ids that are trusted (your own MX). Results from any other
# authserv-id are shown as "reported, unverified".
PHISHDNA_TRUSTED_AUTHSERV_IDS=

# ---- Optional external threat intelligence (disabled unless both are set) ----
# Sending indicators to a third party is a data transfer. Enable only when authorised.
PHISHDNA_ENABLE_EXTERNAL_LOOKUPS=false
VIRUSTOTAL_API_KEY=

# CORS origins for the frontend dev server
PHISHDNA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
